# Django Application Configuration
SECRET_KEY=django-insecure-appointmentguard-dev-secret-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://appointment_user:appointment_pass@db:5432/appointmentguard_db
POSTGRES_DB=appointmentguard_db
POSTGRES_USER=appointment_user
POSTGRES_PASSWORD=appointment_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432
